// Library entry: function code is at SP-5.
MOV R1, SP
MOV R2, 5
SUB R1, R2
MOV R0, [R1]
MOV R1, R0
MOV R2, "Heapset"
EQ R1, R2
JNZ R1, 68
MOV R1, R0
MOV R2, "Alloc"
EQ R1, R2
JNZ R1, 110
MOV R1, R0
MOV R2, "Free"
EQ R1, R2
JNZ R1, 172
MOV R1, R0
MOV R2, "Write"
EQ R1, R2
JNZ R1, 270
MOV R1, R0
MOV R2, "Read"
EQ R1, R2
JNZ R1, 320
MOV R1, R0
MOV R2, "Exit"
EQ R1, R2
JNZ R1, 378
// Unknown function code: return failure.
MOV R1, SP
MOV R2, 1
SUB R1, R2
MOV R2, -1
MOV [R1], R2
RET

// Heapset: reserve 1024 for the free-list head; link blocks 1032..2040.
MOV R1, 1032
MOV R2, 1040
MOV R3, 2040
MOV R4, R1
EQ R4, R3
JNZ R4, 88
MOV [R1], R2
ADD R1, 8
ADD R2, 8
JMP 74
MOV R4, -1
MOV [R1], R4
MOV R1, 1024
MOV R2, 1032
MOV [R1], R2
MOV R1, SP
MOV R2, 1
SUB R1, R2
MOV R2, 0
MOV [R1], R2
RET

// Alloc: remove and return the first free block; the fixed block size is 8.
MOV R1, SP
MOV R2, 4
SUB R1, R2
MOV R2, [R1]
MOV R3, 0
MOV R4, R2
LE R4, R3
JNZ R4, 160
MOV R3, 8
MOV R4, R2
GT R4, R3
JNZ R4, 160
MOV R1, 1024
MOV R2, [R1]
MOV R3, -1
MOV R4, R2
EQ R4, R3
JNZ R4, 160
MOV R3, [R2]
MOV [R1], R3
MOV R1, SP
MOV R3, 1
SUB R1, R3
MOV [R1], R2
RET
MOV R1, SP
MOV R2, 1
SUB R1, R2
MOV R2, -1
MOV [R1], R2
RET

// Free: validate the block address, reject a duplicate free, then relink it.
MOV R1, SP
MOV R2, 4
SUB R1, R2
MOV R1, [R1]
MOV R2, 1032
MOV R3, R1
LT R3, R2
JNZ R3, 258
MOV R2, 2040
MOV R3, R1
GT R3, R2
JNZ R3, 258
MOV R2, R1
SUB R2, 1032
MOV R3, 8
MOD R2, R3
JNZ R2, 258
MOV R2, [1024]
MOV R3, -1
MOV R4, R2
EQ R4, R3
JNZ R4, 226
MOV R4, R2
EQ R4, R1
JNZ R4, 258
MOV R2, [R2]
JMP 210
MOV R5, [1024]
MOV R3, R1
MOV R4, 0
MOV R6, 8
MOV [R3], R4
INR R3
DCR R6
JNZ R6, 234
MOV [R1], R5
MOV [1024], R1
MOV R2, SP
MOV R3, 1
SUB R2, R3
MOV R3, 0
MOV [R2], R3
RET
MOV R1, SP
MOV R2, 1
SUB R1, R2
MOV R2, -1
MOV [R1], R2
RET

// Write: forward the library arguments to the XSM Write system call.
MOV R1, SP
MOV R2, 4
SUB R1, R2
MOV R2, [R1]
INR R1
MOV R3, [R1]
INR R1
MOV R4, [R1]
MOV R5, 5
PUSH R5
PUSH R2
PUSH R3
PUSH R4
PUSH R0
INT 7
POP R1
POP R2
POP R2
POP R2
POP R2
MOV R2, SP
MOV R3, 1
SUB R2, R3
MOV [R2], R1
RET

// Read: forward the library arguments to the XSM Read system call.
MOV R1, SP
MOV R2, 4
SUB R1, R2
MOV R2, [R1]
INR R1
MOV R3, [R1]
INR R1
MOV R4, [R1]
MOV R5, 7
PUSH R5
PUSH R2
PUSH R3
PUSH R4
PUSH R0
INT 6
POP R1
POP R2
POP R3
POP R2
POP R2
MOV R4, [R3]
MOV R2, SP
MOV R3, 1
SUB R2, R3
MOV [R2], R1
DCR R2
DCR R2
MOV [R2], R4
RET

// Exit: this service does not return to the caller.
INT 10
RET
